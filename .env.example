# Anthropic Claude API key, used to write the French digest summary
ANTHROPIC_API_KEY=

# Resend API key (https://resend.com), used to send the digest email
RESEND_API_KEY=

# Sender must be on a domain verified in your Resend account
EMAIL_FROM=digest@yourdomain.org
# Comma-separated list of recipients
EMAIL_TO=association@example.org

# Optional: NCBI API key, raises the PubMed E-utilities rate limit (not required)
NCBI_API_KEY=
